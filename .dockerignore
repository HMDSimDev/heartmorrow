# Dependencies + build artifacts are recreated inside the image.
node_modules
**/node_modules
apps/web/dist
**/dist

# Local runtime data — NEVER bake a user's SQLite DB / uploads into the image.
data
**/data
.env
.env.*

# Vendored self-contained toolchain from install.sh (huge, host-specific).
.runtime

# Internal tooling and repo-page assets Docker users never run: the screenshot
# tool exists to refresh the GitHub README, and gh/ holds the README's images.
tools
gh

# do not pick up any LLM-related files the user might have installed if they are working on this with an LLM
.claude
.codex
AGENTS.MD
CLAUDE.MD

# VCS / CI / editor / OS noise.
.git
.gitignore
.gitattributes
.github
**/*.log
**/.DS_Store
**/Thumbs.db
